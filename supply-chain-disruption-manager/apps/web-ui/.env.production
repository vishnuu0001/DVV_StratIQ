# Production environment - used by `npm run build`.
# IIS web.config proxies /api/kg/*, /api/inspector/*, /api/agents/* to their respective
# backend ports, so use same-origin relative paths (not localhost:PORT) here.
# API keys must match each backend's configured value exactly (see ../../.env) —
# without this file, Vite has no VITE_* vars available at build time (this directory
# has no .env of its own) and silently falls back to the hardcoded dev-key defaults
# in src/api/{agents,inspector,kg}.ts, which is what caused the agent-service 401s.
VITE_KG_API_URL=/api/kg
VITE_KG_API_KEY=kg-dev-key-change-in-prod
VITE_INSPECTOR_API_URL=/api/inspector
VITE_INSPECTOR_API_KEY=inspector-dev-key
VITE_AGENT_API_URL=/api/agents
VITE_AGENT_API_KEY=agent-dev-key-change-in-prod
