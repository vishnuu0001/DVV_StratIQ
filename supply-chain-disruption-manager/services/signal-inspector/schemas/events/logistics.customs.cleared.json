{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "logistics.customs.cleared",
  "type": "object",
  "required": ["shipment_id", "port", "cleared_at"],
  "properties": {
    "shipment_id": {"type": "string"},
    "port": {"type": "string"},
    "cleared_at": {"type": "string", "format": "date-time"},
    "dwell_days": {"type": "number", "minimum": 0},
    "customs_ref": {"type": "string"},
    "duties_paid": {"type": "number", "minimum": 0},
    "currency": {"type": "string"}
  },
  "additionalProperties": true
}
