# Signal Inspector — Environment Configuration
# Copy to .env and fill in values.

# ---- Postgres ----
POSTGRES_URL=postgresql+asyncpg://sc_admin:sc_secret@postgres:5432/disruption_mgr

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- KG Service ----
KG_BASE_URL=http://kg-service:8001
KG_API_KEY=kg-dev-key-change-in-prod

# ---- Agent Service ----
AGENT_BASE_URL=http://agent-service:8002
AGENT_API_KEY=agent-dev-key-change-in-prod

# ---- ERP Webhook HMAC ----
INSPECTOR_ERP_HMAC_SECRET=erp-hmac-secret-change-in-prod

# ---- MQTT (optional) ----
MQTT_BROKER=localhost
MQTT_PORT=1883
MES_MQTT_ENABLED=false

# ---- WMS Poll (optional) ----
WMS_POLL_URL=http://wms-service/api/events
WMS_POLL_INTERVAL_SECONDS=30

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=true

# ---- App ----
ENVIRONMENT=development
DEBUG=false
