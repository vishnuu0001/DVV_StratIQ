# ============================================================
# Supply Chain Disruption Manager — Environment Configuration
# Copy to .env and fill in values before running.
# ============================================================

# ---- Neo4j ----
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=disruption123
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sc_admin
POSTGRES_PASSWORD=sc_secret
POSTGRES_DB=disruption_mgr
POSTGRES_URL=postgresql+asyncpg://sc_admin:sc_secret@postgres:5432/disruption_mgr

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---- KG Service ----
KG_API_KEY=kg-dev-key-change-in-prod
KG_BASE_URL=http://kg-service:8001
KG_SEED_ENABLED=true

# ---- Signal Inspector ----
INSPECTOR_BASE_URL=http://signal-inspector:8003
INSPECTOR_ERP_HMAC_SECRET=erp-hmac-secret-change-in-prod

# ---- Agent Service ----
AGENT_API_KEY=agent-dev-key-change-in-prod
AGENT_BASE_URL=http://agent-service:8002

# ---- LLM Provider (local Ollama — use host.docker.internal from containers) ----
OLLAMA_BASE_URL=http://host.docker.internal:11434
ORCHESTRATOR_MODEL=llama3.1:8b
SPECIALIST_MODEL=llama3.1:8b
MOCK_AGENTS=true

# ---- MQTT (optional for local dev) ----
MQTT_BROKER=localhost
MQTT_PORT=1883
MES_MQTT_ENABLED=false

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=true

# ---- Dev flags ----
ENVIRONMENT=development
DEBUG=false
