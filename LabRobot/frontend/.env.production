# Lab Robot frontend production configuration
VITE_LAB_API_URL=/api/lab

# Local Aedes MQTT broker (managed by watchdog_all_backends.ps1, see
# LabRobot/mqtt-broker/broker.js) — WebSocket listener on :9001. No
# VITE_MQTT_URL here on purpose: the app builds ws://<page-host>:9001/mqtt
# at runtime so it works whether you're browsing from the server itself or
# from another machine on the network — a hardcoded "localhost" only ever
# resolves to the browser's own machine, not the server.
VITE_MQTT_ENABLED=true
VITE_MQTT_WS_PORT=9001
VITE_MQTT_COMMAND_TOPIC=labrobot/commands
VITE_MQTT_ACK_TOPIC=labrobot/ack
