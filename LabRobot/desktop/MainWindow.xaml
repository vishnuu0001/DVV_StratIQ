<Window x:Class="LabRobot.WindowsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Lab Robot Windows App"
        Width="1500"
        Height="900"
        MinWidth="1050"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="White">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="64" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#101010" BorderBrush="#333333" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="86" />
          <ColumnDefinition Width="250" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0078D4">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="LR" FontSize="20" FontWeight="Bold" />
          </StackPanel>
        </Border>
        <TextBlock Grid.Column="1" Text="Lab Robot Windows App" Margin="22,0,0,0"
                   VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="BackButton" Click="BackButton_Click" ToolTip="Back" Width="40" Height="40" Tag="5" IsEnabled="False">
            <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="17" />
          </Button>
          <Button x:Name="ForwardButton" Click="ForwardButton_Click" ToolTip="Forward" Width="40" Height="40" Tag="5" IsEnabled="False">
            <TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons" FontSize="17" />
          </Button>
          <Button x:Name="RefreshButton" Click="RefreshButton_Click" ToolTip="Refresh" Width="40" Height="40" Tag="5" IsEnabled="False">
            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons" FontSize="17" />
          </Button>
          <Button Click="HomeButton_Click" ToolTip="App home" Width="40" Height="40" Tag="5">
            <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="17" />
          </Button>
        </StackPanel>

        <Border Grid.Column="3" Margin="14,11" Background="#262626" BorderBrush="#585858" BorderThickness="1" CornerRadius="6">
          <TextBlock x:Name="AddressText" Text="App home" Margin="14,0" VerticalAlignment="Center"
                     Foreground="#C9C9C9" TextTrimming="CharacterEllipsis" />
        </Border>

        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
          <Button x:Name="ExternalButton" Click="ExternalButton_Click" ToolTip="Open current page in default browser"
                  Width="44" Height="40" Tag="5" IsEnabled="False">
            <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons" FontSize="17" />
          </Button>
          <Border Width="38" Height="38" Margin="8,0,0,0" BorderBrush="#FFFFFF" BorderThickness="1" CornerRadius="19">
            <TextBlock Text="LR" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="96" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#090909" BorderBrush="#2E2E2E" BorderThickness="0,0,1,0">
        <StackPanel Margin="8,18">
          <Button Click="HomeButton_Click" Height="68" Margin="0,0,0,8" Tag="6">
            <StackPanel>
              <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons" FontSize="22" HorizontalAlignment="Center" />
              <TextBlock Text="Home" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Click="LabRobotButton_Click" Height="68" Margin="0,0,0,8" Tag="6">
            <StackPanel>
              <TextBlock Text="&#xE7F8;" FontFamily="Segoe Fluent Icons" FontSize="22" HorizontalAlignment="Center" />
              <TextBlock Text="Lab Robot" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Click="ClaudeButton_Click" Height="68" Margin="0,0,0,8" Tag="6">
            <StackPanel>
              <TextBlock Text="AI" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" />
              <TextBlock Text="Claude" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Click="VeoButton_Click" Height="68" Margin="0,0,0,8" Tag="6">
            <StackPanel>
              <TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons" FontSize="22" HorizontalAlignment="Center" />
              <TextBlock Text="Veo" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Click="CopilotButton_Click" Height="68" Tag="6">
            <StackPanel>
              <TextBlock Text="&#xE943;" FontFamily="Segoe Fluent Icons" FontSize="22" HorizontalAlignment="Center" />
              <TextBlock Text="Copilot" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <Grid Grid.Column="1" Background="#1B1B1B">
        <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="46,42">
            <TextBlock Text="STRAT-AQORYNTH AI WORKSPACES" Foreground="#67B7FF" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="Apps" FontSize="36" FontWeight="SemiBold" Margin="0,7,0,0" />
            <TextBlock Text="Open AI studios and Lab Robot operations in one native Windows workspace."
                       Foreground="{StaticResource MutedTextBrush}" FontSize="15" Margin="0,7,0,34" />

            <WrapPanel>
              <Button Click="ClaudeButton_Click" Width="300" Height="250" Margin="0,0,22,22" Padding="0" Tag="12">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="150" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                  <Border Background="#A64B35" CornerRadius="12,12,0,0">
                    <TextBlock Text="AI" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="45" FontWeight="Bold" />
                  </Border>
                  <Border Grid.Row="1" Background="#292929" CornerRadius="0,0,12,12" Padding="18,14">
                    <StackPanel><TextBlock Text="Claude Studio" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Anthropic" Foreground="#D99A87" Margin="0,5,0,0" /><TextBlock Text="Launch in workspace  &#xE72A;" Margin="0,10,0,0" Foreground="#BDBDBD" /></StackPanel>
                  </Border>
                </Grid>
              </Button>

              <Button Click="VeoButton_Click" Width="300" Height="250" Margin="0,0,22,22" Padding="0" Tag="12">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="150" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                  <Border Background="#2457A8" CornerRadius="12,12,0,0">
                    <TextBlock Text="VEO" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="39" FontWeight="Bold" />
                  </Border>
                  <Border Grid.Row="1" Background="#292929" CornerRadius="0,0,12,12" Padding="18,14">
                    <StackPanel><TextBlock Text="Google Veo" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Google Flow" Foreground="#82B1FF" Margin="0,5,0,0" /><TextBlock Text="Launch in workspace  &#xE72A;" Margin="0,10,0,0" Foreground="#BDBDBD" /></StackPanel>
                  </Border>
                </Grid>
              </Button>

              <Button Click="CopilotButton_Click" Width="300" Height="250" Margin="0,0,22,22" Padding="0" Tag="12">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="150" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                  <Border Background="#593BB0" CornerRadius="12,12,0,0">
                    <TextBlock Text="&#xE943;" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="54" />
                  </Border>
                  <Border Grid.Row="1" Background="#292929" CornerRadius="0,0,12,12" Padding="18,14">
                    <StackPanel><TextBlock Text="Microsoft Copilot" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Microsoft" Foreground="#AA98F2" Margin="0,5,0,0" /><TextBlock Text="Launch in workspace  &#xE72A;" Margin="0,10,0,0" Foreground="#BDBDBD" /></StackPanel>
                  </Border>
                </Grid>
              </Button>

              <Button Click="LabRobotButton_Click" Width="300" Height="250" Margin="0,0,22,22" Padding="0" Tag="12">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="150" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                  <Border Background="#0067B8" CornerRadius="12,12,0,0">
                    <TextBlock Text="&#xE7F8;" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="54" />
                  </Border>
                  <Border Grid.Row="1" Background="#292929" CornerRadius="0,0,12,12" Padding="18,14">
                    <StackPanel><TextBlock Text="Lab Robot Control" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Strat-Aqorynth" Foreground="#73C1FF" Margin="0,5,0,0" /><TextBlock Text="Launch in workspace  &#xE72A;" Margin="0,10,0,0" Foreground="#BDBDBD" /></StackPanel>
                  </Border>
                </Grid>
              </Button>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>

        <Grid x:Name="BrowserPanel" Visibility="Collapsed">
          <wv2:WebView2 x:Name="Browser" />
          <Border x:Name="LoadingPanel" Background="#E61B1B1B" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <ProgressBar Width="240" Height="4" IsIndeterminate="True" Foreground="#2899F5" />
              <TextBlock Text="Opening workspace..." HorizontalAlignment="Center" Margin="0,16,0,0" Foreground="#D8D8D8" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
