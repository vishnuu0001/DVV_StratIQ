# Copy to .env and fill in real values. .env is gitignored.

# Google Generative Language API key, used only by the AI Lab catalog's
# Google VEO "Generate Sample Output" demo step (main.py's
# /api/ai-lab/veo/sample). Without this set, that one call returns 503 and
# the frontend falls back to its canned simulated sample text.
GOOGLE_AI_API_KEY=

# Central authority for every Lab Robot API request. Session revocation,
# account status, application permission, and read-only rights are resolved
# here rather than trusted from stale token claims.
PORTAL_AUTH_SESSION_URL=https://strat-iq.azurewebsites.net/api/auth/session
PORTAL_AUTH_TIMEOUT_SECONDS=5
