<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- ARR reverse proxy — if this causes HTTP 500.19, remove this element and run:
         %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/proxy /enabled:true /commit:apphost -->
    <proxy enabled="true" preserveHostHeader="false" reverseRewriteHostInResponseHeaders="false" />

    <!-- Gzip compression (httpCompression is Allow at site level) -->
    <httpCompression directory="%SystemDrive%\inetpub\temp\IIS Temporary Compressed Files">
      <scheme name="gzip" dll="%Windir%\system32\inetsrv\gzip.dll" staticCompressionLevel="9" />
      <dynamicTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="*/*" enabled="false" />
      </dynamicTypes>
      <staticTypes>
        <add mimeType="text/*" enabled="true" />
        <add mimeType="application/javascript" enabled="true" />
        <add mimeType="application/json" enabled="true" />
        <add mimeType="image/svg+xml" enabled="true" />
        <add mimeType="*/*" enabled="false" />
      </staticTypes>
    </httpCompression>

    <!-- 1-year cache for static assets (cacheControlMaxAge is a timespan: days.hh:mm:ss) -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <rewrite>
      <rules>

        <!-- ── Dashboard backend (port 8087) ──────────────────────────────── -->
        <!-- Routes unique to the Dashboard service -->
        <rule name="Proxy Dashboard API" stopProcessing="true">
          <match url="^api/(config|status|connect|sync|disconnect|kpis|monthly-volume|cycle-time|incidents|changes|service-requests|application-hotspots|assignment-group-hotspots|automation-candidates|insights|repeat-incidents|rca-ownership|preventive-maintenance|adhoc-vs-bau|sla-breach-risk|transformation-kpis|people-capacity|invoke-critical-incident|critical-alerts)(.*)" />
          <action type="Rewrite" url="http://localhost:8087/{R:0}" />
        </rule>
        <rule name="Proxy Dashboard Metrics" stopProcessing="true">
          <match url="^metrics$" />
          <action type="Rewrite" url="http://localhost:8087/metrics" />
        </rule>
        <rule name="Proxy Dashboard Render" stopProcessing="true">
          <match url="^render/(.*)" />
          <action type="Rewrite" url="http://localhost:8087/{R:0}" />
        </rule>
        <rule name="Proxy IntuneAutomation API" stopProcessing="true">
          <match url="^api/intune/(.*)" />
          <action type="Rewrite" url="http://localhost:8088/api/{R:1}" />
        </rule>
        <rule name="Proxy Tool Analysis API" stopProcessing="true">
          <match url="^api/tools/(.*)" />
          <action type="Rewrite" url="http://localhost:8010/api/{R:1}" />
        </rule>

        <!-- ── CodeAnalysis backend (port 8082) ───────────────────────────── -->
        <!-- Routes unique to CodeAnalysis -->
        <rule name="Proxy CA Unique API" stopProcessing="true">
          <match url="^api/(analyse|portfolio|ai|db|modules|reports|jobs|health)(.*)" />
          <action type="Rewrite" url="http://localhost:8082/{R:0}" />
        </rule>
        <!-- /api/auth conflicts between CA and Novastra-ITSM — disambiguate by Referer -->
        <rule name="Proxy CA Auth" stopProcessing="true">
          <match url="^api/auth(.*)" />
          <conditions>
            <add input="{HTTP_REFERER}" pattern="://[^/]*/ca/" />
          </conditions>
          <action type="Rewrite" url="http://localhost:8082/{R:0}" />
        </rule>

        <!-- ── Novastra-ITSM backend (port 8086) ───────────────────── -->
        <rule name="Proxy Novastra-ITSM Health" stopProcessing="true">
          <match url="^health$" />
          <action type="Rewrite" url="http://localhost:8086/health" />
        </rule>
        <!-- Catch-all for remaining /api/* — covers all Novastra-ITSM-specific prefixes
             (admin, agent, auth, chat-history, dashboard, datasources, feedback,
              incident-workbench, knowledge-graph, search, servicenow, settings,
              ticket-analysis) and /api/auth when Referer is not /ca/ -->
        <rule name="Proxy Novastra-ITSM API" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:8086/{R:0}" />
        </rule>

        <!-- ── AI_Reman_Core backend (port 8093) ─────────────────────────── -->
        <rule name="Proxy AI Reman Core API" stopProcessing="true">
          <match url="^api/reman/(.*)" />
          <action type="Rewrite" url="http://localhost:8093/api/{R:1}" />
        </rule>

        <!-- ── AI_Vehicle_Loan backend (port 8094) ────────────────────────── -->
        <rule name="Proxy AI Vehicle Loan API" stopProcessing="true">
          <match url="^api/vl/(.*)" />
          <action type="Rewrite" url="http://localhost:8094/api/{R:1}" />
        </rule>

        <!-- ── TM_EPOS API gateway (port 8095) ────────────────────────────── -->
        <!-- Routes all /api/epos/* to the ePOS API gateway which proxies internally -->
        <rule name="Proxy TM EPOS API" stopProcessing="true">
          <match url="^api/epos/(.*)" />
          <action type="Rewrite" url="http://localhost:8095/api/{R:1}" />
        </rule>
        <!-- ePOS frontend SPA served under /epos/ -->
        <rule name="Proxy TM EPOS Frontend" stopProcessing="true">
          <match url="^epos/(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="http://localhost:5186/epos/{R:1}" />
        </rule>

        <!-- ── SPA catch-all — serve index.html for client-side routes ─────── -->
        <!-- Handles hard refresh (Ctrl+Shift+R) on /dashboard, /ki, /ca, etc.  -->
        <rule name="SPA Fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>

      </rules>

      <outboundRules>
        <!-- Override cache-control for HTML via outbound rewrite rule -->
        <rule name="NoCache HTML" preCondition="IsHTML" stopProcessing="true">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <action type="Rewrite" value="no-cache, no-store, must-revalidate" />
        </rule>
        <preConditions>
          <preCondition name="IsHTML">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="text/html" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <!-- Security headers -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
      </customHeaders>
    </httpProtocol>

    <!-- Note: webSocket is locked (Deny) at site level — enabled globally via applicationHost.config -->

  </system.webServer>
</configuration>
