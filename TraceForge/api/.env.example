# Local dev only — production reads the same shape of values from this repo's
# watchdog_all_backends.ps1 service block (no Azure Key Vault / Managed Identity
# in this deployment; see TraceForge/Requirements.MD note at the top for context).

AUTH_TOKEN_SECRET=change_me_shared_secret
AUTH_REQUIRED=true
ALLOW_LOCAL_AUTH_BYPASS=true
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8090,http://127.0.0.1:8090,http://localhost:5186,http://127.0.0.1:5186

DATABASE_URL=postgresql+asyncpg://tf_admin:tf_secret@localhost:5432/traceforge
REDIS_URL=redis://127.0.0.1:6379/3

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_SECONDS=300
AGENT_WORKER_CONCURRENCY=1
AGENT_JOB_TIMEOUT_SECONDS=14400
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_DIM=768
TRACEFORGE_PERFORMANCE_MODE=fast
EXTRACT_MAX_TOKENS=4500
TEST_PLAN_MAX_TOKENS=1200
TEST_CASE_MAX_TOKENS=1800
SCRIPT_MAX_TOKENS=1000
