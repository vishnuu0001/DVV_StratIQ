# ─────────────────────────────────────────────────────────────
# Novastra-ITSM environment variables — copy to .env and customise
# ─────────────────────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────────────────────
# Options: "ollama" | "openai"
LLM_PROVIDER=ollama

# ── Ollama settings ───────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_ANALYSIS_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_NUM_GPU=1
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=768
OLLAMA_EMBED_TIMEOUT_SECONDS=12
OLLAMA_ANALYSIS_NUM_CTX=2048
OLLAMA_ANALYSIS_NUM_PREDICT=256
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_ANALYSIS_TIMEOUT_SECONDS=45
OLLAMA_KEEP_ALIVE=15m
OLLAMA_REQUIRE_GPU=true
QUERY_JOB_TIMEOUT_SECONDS=25
FEATURE_JOB_TIMEOUT_SECONDS=45

# ── OpenAI settings (optional) ───────────────────────────────
# Leave blank to disable OpenAI. Required only if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Authentication
# REQUIRED — no default. Use independent secrets in production. PORTAL_AUTH_TOKEN_SECRET
# must exactly match AppRationalization's AUTH_TOKEN_SECRET for portal SSO handoff.
JWT_SECRET=replace-with-a-strong-novastra-session-secret
PORTAL_AUTH_TOKEN_SECRET=replace-with-the-portal-auth-token-secret
JWT_EXPIRE_SECONDS=86400

# ── Settings encryption ────────────────────────────────────────
# REQUIRED whenever the Settings UI persists LLM provider config to the DB.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# ── RAG / PostgreSQL pgvector ────────────────────────────────
DB_BACKEND=postgres
# REQUIRED when DB_BACKEND=postgres — no default. Replace <user>/<password> below.
POSTGRES_DSN=postgresql://<user>:<password>@localhost:5432/postgres?connect_timeout=10&sslmode=prefer
VECTOR_COLLECTION=kg_support
VECTOR_TABLE=vector_chunks

# ── Vector Store Backend ──────────────────────────────────────
# Options: "lancedb" (recommended) | "qdrant" | "postgres" | "hybrid"
VECTOR_BACKEND=lancedb

# ── Modern Pipeline ───────────────────────────────────────────
MODERN_PIPELINE_ENABLED=true
MODERN_PIPELINE_STRICT=false
SYNC_REQUIRE_DUAL_WRITE=false  # Set to true if using hybrid storage

# ── LanceDB Configuration (Local GPU-accelerated Vector Store) ──
# Path to LanceDB directory (will be created if not exists)
LANCEDB_PATH=./vectorstore/lancedb
LANCEDB_TABLE=incidents_vectors
LANCEDB_METRIC=cosine

# ── GPU/Embedding Configuration (NEW) ───────────────────────
# Enable GPU acceleration for embeddings
GPU_ENABLED=true

# Embedding model options:
# - nomic-embed-text (384-dim, fast, recommended)
# - all-minilm-l6-v2 (384-dim, smaller)
# - bge-small-en-v1.5 (384-dim, multilingual)
# - bge-base-en-v1.5 (768-dim, better quality)
EMBEDDING_MODEL=nomic-embed-text

# Device: cuda (NVIDIA), rocm (AMD), cpu
EMBEDDING_DEVICE=cuda

# Batch size for embedding generation (adjust based on GPU VRAM)
# RTX 3090/4090: 64 | RTX 3080/4080: 32 | RTX 3070: 16 | CPU: 4-8
EMBEDDING_BATCH_SIZE=32

# ── Qdrant (Legacy - kept for backward compatibility) ─────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=novastra_itsm_incidents
QDRANT_TIMEOUT_SECONDS=15
QDRANT_PREFER_GRPC=false
QDRANT_RECREATE_COLLECTION=false

# ── RAG Configuration ──────────────────────────────────────────
RAG_MAX_QUERY_ANGLES=2
RAG_ENABLE_REGEX_LAYER=true
RAG_DIRECT_EXTRACTIVE_MODE=true
RAG_ENABLE_AUGMENT_LAYER=false
RAG_ENABLE_RERANK=false
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=5
MIN_RELEVANCE_SCORE=0.35

# ── Data directory ────────────────────────────────────────────
DATA_DIR=./data

# ── ServiceNow (optional) ─────────────────────────────────────
# Leave blank to use manual/screenshot input only
# Use only the instance base URL (no login.do query params)
SERVICENOW_BASE_URL=https://dev394189.service-now.com
SERVICENOW_USERNAME=admin
# Use raw password text. If you accidentally paste URL-encoded text (%2B, etc.), backend now decodes it.
SERVICENOW_PASSWORD=mpLSK+kH!48n
SERVICENOW_VERIFY_SSL=false
SERVICENOW_TIMEOUT_SECONDS=20

# ── Email intake (optional) ────────────────────────────────────
# Leave EMAIL_IMAP_USERNAME/PASSWORD blank to disable the Email channel poller.
EMAIL_IMAP_ENABLED=true
EMAIL_IMAP_HOST=imap.titan.email
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USERNAME=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_FOLDER=INBOX
EMAIL_IMAP_USE_SSL=true
EMAIL_IMAP_POLL_SECONDS=60
# Comma-separated; leave both blank to allow every non-automated sender.
EMAIL_IMAP_ALLOWED_SENDERS=
EMAIL_IMAP_BLOCKED_SENDERS=
EMAIL_IMAP_FILTER_AUTOMATED_SENDERS=true

# ── App security ──────────────────────────────────────────────
# REQUIRED — no default.
ADMIN_SECRET=replace-with-a-strong-admin-secret
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
