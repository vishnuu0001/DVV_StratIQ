			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "check-watchdog-effects-ports",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-NetTCPConnection -State Listen -ErrorAction SilentlyContinue | Where-Object { $_.LocalPort -in 5432,6379,7474,7687,8001,8002,8003 } | Select-Object LocalAddress,LocalPort,OwningProcess | Sort-Object LocalPort | Format-Table -AutoSize"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "stop-launched-watchdog",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-CimInstance Win32_Process | Where-Object { $_.CommandLine -like '*watchdog_all_backends.ps1*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }; Write-Output 'Stopped watchdog processes launched in this session.'"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "stop-watchdog-window",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/c",
				"taskkill /F /FI \"WINDOWTITLE eq StratIQ-Watchdog*\""
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "stop-watchdog-by-title",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-Process | Where-Object { $_.MainWindowTitle -like 'StratIQ-Watchdog*' } | Stop-Process -Force -ErrorAction SilentlyContinue; 'done'"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "stop-watchdog-by-title-escaped",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-Process | Where-Object { $_.MainWindowTitle -like \\\"StratIQ-Watchdog*\\\" } | Stop-Process -Force -ErrorAction SilentlyContinue; Write-Output done"
			],
			"isBackground": false,
			"group": "build"
		}
	]
