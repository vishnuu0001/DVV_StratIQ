		{
			"label": "check-infra-ports",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/c",
				"netstat -ano | findstr /R \":5432 .*LISTENING :6379 .*LISTENING :7474 .*LISTENING :7687 .*LISTENING\""
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "check-infra-ports-powershell",
			"type": "shell",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"Get-NetTCPConnection -State Listen -ErrorAction SilentlyContinue | Where-Object { $_.LocalPort -in 5432,6379,7474,7687,8001,8002,8003 } | Select-Object LocalAddress,LocalPort,OwningProcess | Sort-Object LocalPort | Format-Table -AutoSize"
			],
			"isBackground": false,
			"group": "build"
		},
