			"command": "cmd.exe",
			"args": [
				"/c",
				"cd /d E:\\stratIQ_VA-main\\stratIQ_VA-main\\supply-chain-disruption-manager && set PYTHONPATH=E:\\stratIQ_VA-main\\stratIQ_VA-main\\supply-chain-disruption-manager\\services\\kg-service\\src && set ENVIRONMENT=development && set DEBUG=true && set LOG_JSON=false && set NEO4J_URI=bolt://localhost:7687 && set NEO4J_USER=neo4j && set NEO4J_PASSWORD=disruption123 && set KG_API_KEY=kg-dev-key-change-in-prod && E:\\stratIQ_VA-main\\stratIQ_VA-main\\supply-chain-disruption-manager\\services\\kg-service\\.venv\\Scripts\\python.exe -m uvicorn kg.main:app --host 127.0.0.1 --port 8001"
			],
			"isBackground": false,
			"group": "build"
