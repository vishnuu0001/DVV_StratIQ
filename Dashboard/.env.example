# ─────────────────────────────────────────────────────────────
# Dashboard environment variables — copy to .env and customise
# ─────────────────────────────────────────────────────────────

# ── Auth (shared platform secret) ───────────────────────────────
AUTH_TOKEN_SECRET=replace-with-the-shared-strat-aqorynth-auth-secret

# ── PostgreSQL — encrypted settings persistence (NEW) ────────────
# REQUIRED — no default. Dashboard previously had no database; the ServiceNow
# connection panel (url/username/password) now persists here, encrypted,
# instead of being echoed to the UI straight from .env in plaintext. Reuses
# the same default postgres/postgres role Novastra-ITSM connects to on this
# box (own table, dashboard_ prefix) — no dedicated DB/role needed.
POSTGRES_DSN=postgresql://<user>:<password>@localhost:5432/postgres?connect_timeout=10&sslmode=prefer

# ── Settings encryption (NEW) ────────────────────────────────────
# REQUIRED — no default. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# ── ServiceNow (optional — only used to seed the DB on first run) ──
# Once the Connection panel is used to connect successfully, the DB row takes
# over as the source of truth and these are no longer read.
SERVICENOW_BASE_URL=https://dev393867.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=replace-with-servicenow-password
SERVICENOW_VERIFY_SSL=true
SERVICENOW_TIMEOUT_SECONDS=60

# ── Ollama (local GPU inference) ─────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_ENABLED=true

# ── Qdrant (critical alert persistence) ──────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=dashboard_critical_alerts
QDRANT_ENABLED=true

# ── Auto-sync scheduler ───────────────────────────────────────────
AUTO_SYNC_INTERVAL_MINUTES=10

# ── CORS (browser origins allowed to call Dashboard API) ──────────
CORS_ORIGINS=https://stratapp.org,https://www.stratapp.org,https://api.stratapp.org,http://localhost,http://127.0.0.1,http://localhost:8090,http://127.0.0.1:8090
