# GitHub Personal Access Token (read:repo scope is sufficient for public repos)
# Required for private repos and to avoid rate limiting on large portfolio scans
GITHUB_TOKEN=ghp_your_token_here

# Shared authentication secret (must match AppRationalization AUTH_TOKEN_SECRET)
AUTH_TOKEN_SECRET=change-this-shared-auth-token-secret

# Keep true to enforce portal login and app-level permission checks
AUTH_REQUIRED=true

# Frontend to backend URL overrides (optional)
# VITE_CODE_ANALYSIS_API_URL=http://localhost:8000
# VITE_PORTAL_API_URL=http://localhost:5000/api
# VITE_PORTAL_LOGIN_URL=http://localhost:3000/login
# VITE_PORTAL_HOME_URL=http://localhost:3000/launch-modules
